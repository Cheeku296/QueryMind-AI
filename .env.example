# Application Environment Configuration
APP_NAME=QueryMind AI
APP_ENV=development
PORT=8000
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=generate_a_secure_random_jwt_secret_key_32_bytes_or_more
ENCRYPTION_KEY=generate_a_urlsafe_base64_encoded_32_byte_fernet_key=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Database (Application Data)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/querymind
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/querymind

# Demo Database (Target Database for NL-to-SQL evaluation and testing)
DEMO_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/querymind_demo
ASYNC_DEMO_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/querymind_demo

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Vector Database (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=querymind_schemas

# AI Provider Configuration (Default: Google Gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Optional Alternative Provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Observability (Optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGCHAIN_PROJECT=querymind-ai

# Security & CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
ALLOWED_HOSTS=["*"]

# SQL Execution Security Defaults
SQL_QUERY_TIMEOUT_SECONDS=15
SQL_MAX_ROWS_RETURNED=500
SQL_MAX_CORRECTION_ATTEMPTS=2
